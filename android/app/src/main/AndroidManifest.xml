<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.lite2.control" android:versionCode="40" android:versionName="0.3.15">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <application android:extractNativeLibs="true" android:label="Lite 2 Control" android:theme="@style/ControlTheme" android:icon="@drawable/ic_control" android:allowBackup="false" android:enableOnBackInvokedCallback="false">
        <service android:name=".SlotService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Listen for Lite 2 controller slot buttons while other apps are in use"/>
        </service>
        <activity android:name=".ControlActivity" android:exported="true" android:launchMode="singleTop" android:configChanges="keyboard|keyboardHidden|navigation|screenSize|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>

